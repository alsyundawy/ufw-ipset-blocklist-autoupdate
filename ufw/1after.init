#!/usr/bin/env bash
# ##################################################
# ufw-ipset-blocklist-autoupdate
#
# Blocking lists of IPs from public blocklists / blacklists (e.g. blocklist.de, spamhaus.org)
# Load & manage IPSET blocklists for UFW/iptables (IPv4)
#
# Version: 1.2.1
#
# MIT License
# ##################################################

set -euo pipefail
IFS=$'\n\t'

# === Configuration & Binaries ===
IPSET_BIN="$(command -v ipset || true)"
IPTABLES_BIN="$(command -v iptables || true)"
IPSET_DIR="/var/lib/ipset"
LOG_PREFIX="[UFW BLOCK]"

# === Logging Functions ===
log() {
	local msg="$1"
	local timestamp
	timestamp="$(date +'%Y-%m-%d %H:%M:%S')"
	if command -v logger >/dev/null 2>&1; then
		printf '%s - %s\n' "${timestamp}" "${msg}" | logger -t ufw-ipset-blocklist
	fi
	printf '%s - %s\n' "${timestamp}" "${msg}"
}

log_error() {
	local msg="$1"
	local timestamp
	timestamp="$(date +'%Y-%m-%d %H:%M:%S')"
	if command -v logger >/dev/null 2>&1; then
		printf '%s - ERROR: %s\n' "${timestamp}" "${msg}" | logger -t ufw-ipset-blocklist -p user.err
	fi
	printf '%s - ERROR: %s\n' "${timestamp}" "${msg}" >&2
}

# === Sanity Checks ===
if [[ ${EUID} -ne 0 ]]; then
	log_error "Script must be run as root."
	exit 1
fi

if [[ -z "${IPSET_BIN}" || ! -x "${IPSET_BIN}" ]]; then
	log_error "ipset binary not found in PATH or not executable."
	exit 1
fi

if [[ -z "${IPTABLES_BIN}" || ! -x "${IPTABLES_BIN}" ]]; then
	log_error "iptables binary not found in PATH or not executable."
	exit 1
fi

if [[ ! -d "${IPSET_DIR}" ]]; then
	log_error "ipset data directory does not exist: ${IPSET_DIR}"
	exit 1
fi

# === Helper Functions ===
format_log_prefix() {
	local listname="$1"
	local full_prefix="${LOG_PREFIX} ${listname} "
	# iptables --log-prefix maximum length is 29 characters (XT_LOG_MAXPREFIX = 30 with NUL)
	printf '%.29s' "${full_prefix}"
}

rule_exists() {
	local bin="$1"
	local chain="$2"
	local listname="$3"
	local target="$4"
	shift 4
	"${bin}" -C "${chain}" -m set --match-set "${listname}" src -j "${target}" "$@" 2>/dev/null
}

add_firewall_rules() {
	local listname="$1"
	local prefix
	prefix="$(format_log_prefix "${listname}")"

	if ! rule_exists "${IPTABLES_BIN}" INPUT "${listname}" DROP; then
		"${IPTABLES_BIN}" -I INPUT -m set --match-set "${listname}" src -j DROP
	fi

	if ! rule_exists "${IPTABLES_BIN}" INPUT "${listname}" LOG --log-prefix "${prefix}" --log-level 4; then
		"${IPTABLES_BIN}" -I INPUT -m set --match-set "${listname}" src -j LOG --log-prefix "${prefix}" --log-level 4
	fi

	log "Added iptables rules for ${listname}"
}

remove_firewall_rules() {
	local listname="$1"
	local prefix
	prefix="$(format_log_prefix "${listname}")"

	while "${IPTABLES_BIN}" -D INPUT -m set --match-set "${listname}" src -j LOG --log-prefix "${prefix}" --log-level 4 2>/dev/null; do
		log "Removed LOG rule for ${listname}"
	done

	while "${IPTABLES_BIN}" -D INPUT -m set --match-set "${listname}" src -j DROP 2>/dev/null; do
		log "Removed DROP rule for ${listname}"
	done
}

load_blocklists() {
	while IFS= read -r -d '' f; do
		[[ ! -s "${f}" ]] && continue
		local listname
		listname="$(basename "${f}" .save)"

		log "Restoring ipset list: ${listname}"
		if ! "${IPSET_BIN}" restore -! <"${f}"; then
			log_error "Failed to restore ipset list: ${listname}"
			continue
		fi

		add_firewall_rules "${listname}"
	done < <(find "${IPSET_DIR}" -maxdepth 1 -type f -name "*-inet.save" -print0)
}

unload_blocklists() {
	while IFS= read -r -d '' f; do
		[[ ! -e "${f}" ]] && continue
		local listname
		listname="$(basename "${f}" .save)"

		remove_firewall_rules "${listname}"

		if "${IPSET_BIN}" destroy -q "${listname}" 2>/dev/null; then
			log "Destroyed ipset list: ${listname}"
		else
			log "ipset list ${listname} already destroyed or not present."
		fi
	done < <(find "${IPSET_DIR}" -maxdepth 1 -type f -name "*-inet.save" -print0)
}

# === Main Entrypoint ===
case "${1:-}" in
start)
	log "Starting IPSET blocklist loading..."
	load_blocklists
	log "IPSET blocklist loaded successfully."
	;;
stop)
	log "Stopping IPSET blocklist..."
	unload_blocklists
	log "IPSET blocklist stopped."
	;;
status)
	echo "=== Current IPSET Lists ==="
	if [[ -x "${IPSET_BIN}" ]]; then
		all_sets="$("${IPSET_BIN}" list -n 2>/dev/null || true)"
		if [[ -n "${all_sets}" ]]; then
			while IFS= read -r set_name; do
				[[ -z "${set_name}" ]] && continue
				header="$("${IPSET_BIN}" list "${set_name}" 2>/dev/null | grep -E '^(Type|Header|Members|Number of entries):' || true)"
				echo "[-] Set: ${set_name}"
				if [[ -n "${header}" ]]; then
					printf '    %s\n' "${header//$'\n'/$'\n    '}"
				fi
			done <<<"${all_sets}"
		else
			echo "No ipset lists found."
		fi
	else
		log_error "ipset binary not executable."
		exit 1
	fi
	;;
*)
	echo "Usage: $0 {start|stop|status}"
	exit 1
	;;
esac
